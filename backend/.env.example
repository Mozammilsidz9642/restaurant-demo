# Demo-only database. Never point this at a production cluster.
MONGO_URI=mongodb://127.0.0.1:27017/urban_spice_demo

PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-demo-secret

# White-label backend copy
RESTAURANT_NAME=Urban Spice Bistro
RESTAURANT_ADDRESS=123 Main Market, Sector 18, Noida
RESTAURANT_PHONE=+91 98765 43210
RESTAURANT_EMAIL=contact@urbanspice.demo

# Razorpay sandbox/test credentials only
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-secret

# Optional sandbox/test delivery credentials
SHADOWFAX_BASE_URL=https://hlbackend.staging.shadowfax.in
SHADOWFAX_API_KEY=replace-with-sandbox-api-key
SHADOWFAX_CLIENT_CODE=replace-with-sandbox-client-code

# Optional test notification credentials
FAST2SMS_API_KEY=replace-with-test-api-key
META_WA_TOKEN=replace-with-test-token
META_WA_PHONE_NUMBER_ID=replace-with-test-phone-number-id
META_WA_TEMPLATE_NAME=order_confirmation
EMAIL_USER=demo@example.test
EMAIL_PASS=replace-with-test-password
